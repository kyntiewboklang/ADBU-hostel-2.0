<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Complaint Page"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_gravity="center"
        android:layout_marginTop="32dp" />


    <EditText
        android:id="@+id/etComplaintTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter your complaint title"
        android:padding="12dp" />

    <EditText
        android:id="@+id/etComplaintDesc"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:hint="Enter your complaint..."
        android:padding="12dp"
        android:layout_marginTop="10dp"
        android:background="#EEEEEE" />

    <Button
        android:id="@+id/btnSubmitComplaint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Submit Complaint"
        android:layout_marginTop="20dp" />

</LinearLayout>
