<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter Room no"
        android:textSize="13sp"
        android:paddingBottom="12dp" />

    <EditText
        android:id="@+id/et_room_number"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Room No"
        android:inputType="textPersonName"
        android:padding="10dp"
        android:background="@drawable/bg_input" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Room Type"
        android:textSize="13sp"
        android:paddingBottom="12dp" />


    <Spinner
        android:id="@+id/spinnerRoomType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:spinnerMode="dropdown"
        android:prompt="@string/select_room_type_prompt" />


    <Button
        android:id="@+id/btnSubmitAllot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Confirm Allotment"
        android:padding="14dp"
        android:layout_marginTop="20dp" />
</LinearLayout>
