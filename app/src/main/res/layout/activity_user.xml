<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:padding="16dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <ImageView
            android:id="@+id/menu_icon"
            android:layout_width="47dp"
            android:layout_height="52dp"
            android:layout_alignParentStart="true"
            android:layout_marginStart="324dp"
            android:clickable="true"
            android:contentDescription="@string/menu_icon_desc"
            android:focusable="true"
            android:src="@drawable/menubar" />

        <TextView
            android:id="@+id/app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            />
    </RelativeLayout>

    <!-- Search Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/white"
        android:elevation="4dp"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp">

        <EditText
            android:id="@+id/searchEditText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Search..."
            android:textColor="#000000"
            android:textColorHint="#757575"
            android:background="@android:color/transparent"
            android:inputType="text"
            android:drawableStart="@android:drawable/ic_menu_search"
            android:drawablePadding="8dp"
            android:padding="8dp" />
    </RelativeLayout>

    <!-- Book Room -->
    <LinearLayout
        android:id="@+id/btn_room_request"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/rounded_edittext"
        android:backgroundTint="@color/medium_blue"
        android:layout_marginTop="32dp">

        <TextView
            android:layout_width="190dp"
            android:layout_height="wrap_content"
            android:layout_margin="5dp"
            android:text="BOOK A ROOM"
            android:fontFamily="@font/baloo"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="23sp" />
    </LinearLayout>

    <!-- Icon Row -->
    <LinearLayout
        android:id="@+id/icon_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="32dp"
        android:weightSum="3">

        <!-- Room Detail -->
        <LinearLayout
            android:id="@+id/btn_roomdetail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">

            <RelativeLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/rounded_edittext"
                android:backgroundTint="@color/mauve"
                android:layout_gravity="center">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/outline_analytics_24"
                    android:layout_centerInParent="true" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Room Detail"
                android:layout_marginTop="8dp"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Pay Fee -->
        <LinearLayout
            android:id="@+id/btn_user_payment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">

            <RelativeLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/rounded_edittext"
                android:backgroundTint="@color/mauve"
                android:layout_gravity="center">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/payment_icon"
                    android:layout_centerInParent="true" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pay Fee"
                android:layout_marginTop="8dp"
                android:textSize="14sp"/>
        </LinearLayout>


        <LinearLayout
            android:id="@+id/btn_user_complaint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:onClick="openUserComplaint">

            <RelativeLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/rounded_edittext"
                android:backgroundTint="@color/mauve"
                android:layout_gravity="center">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/complaint_icon"
                    android:layout_centerInParent="true" />
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Complaint"
                android:layout_marginTop="8dp"
                android:textSize="14sp"/>
        </LinearLayout>
    </LinearLayout>


    <!-- Explore Hostels -->
    <RelativeLayout
        android:id="@+id/featured_places"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:padding="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EXPLORE HOSTELS"
            android:textColor="@color/medium_blue"
            android:fontFamily="@font/baloo" />
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/featured_recycler"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:clipToPadding="false"
            android:scrollbars="horizontal"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            tools:ignore="NotSibling">


        </androidx.recyclerview.widget.RecyclerView>

    </RelativeLayout>


</LinearLayout>
