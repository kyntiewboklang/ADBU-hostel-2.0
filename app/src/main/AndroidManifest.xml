<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.adbuhostelapp">

    <!-- Internet permission -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.ADBUHostelApp">

        <activity
            android:name=".ui.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity android:name=".ui.UserActivity" />
        <activity android:name=".ui.AdminActivity" />

        <activity android:name=".ui.RoomApplicationActivity" />
        <activity android:name=".PaymentActivity" />
        <activity android:name=".ComplaintActivity" />



    </application>


</manifest>
